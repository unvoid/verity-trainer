# Funcionalidades disponibles en la versión compilada.
# Copia este archivo como `.env.production` (o `.env.local`) y ajusta los valores.
# Valores: true/false (también 1/0, on/off). Sin definir → valor por defecto.

# Pistas (por defecto: true)
VITE_FEATURE_HINTS=true

# Modo desafío (por defecto: true)
VITE_FEATURE_CHALLENGE_MODE=true

# Símbolos por rondas (por defecto: false; aún no implementado)
VITE_FEATURE_SYMBOL_ROUNDS=false
