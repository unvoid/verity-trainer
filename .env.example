# Funcionalidades disponibles en la versión compilada.
# Copia este archivo como `.env.production` (o `.env.local`) y ajusta los valores.
# Valores: true/false (también 1/0, on/off). Sin definir → valor por defecto.

# Pistas (por defecto: true)
VITE_FEATURE_HINTS=true

# Modo desafío (por defecto: true)
VITE_FEATURE_CHALLENGE_MODE=true

# Símbolos por rondas (por defecto: true)
VITE_FEATURE_SYMBOL_ROUNDS=true

# URL pública de la web (sin barra final), para las previsualizaciones al compartir el enlace.
VITE_SITE_URL=https://example.com

# Repositorio público para el icono de GitHub de la cabecera. Vacío = sin icono.
VITE_REPO_URL=https://github.com/unvoid/verity-trainer
