# Funcionalidades disponibles en esta versión (desarrollo y build).
# Ver .env.example y docs/arquitectura.md ("Funcionalidades y ajustes").
# Para recuperar una funcionalidad, ponla a true.

VITE_FEATURE_HINTS=true
VITE_FEATURE_CHALLENGE_MODE=false
VITE_FEATURE_SYMBOL_ROUNDS=false

# URL pública de la web (sin barra final). Se usa en las previsualizaciones al compartir el enlace.
VITE_SITE_URL=https://verity-trainer-eight.vercel.app

# Repositorio público. Vacío = sin icono de GitHub en la cabecera (p. ej. mientras sea privado).
VITE_REPO_URL=
