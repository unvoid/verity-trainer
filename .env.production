# Configuración de producción: la usa `vite build` (también en Vercel). Se sube al
# repositorio porque no contiene secretos. Para desarrollo, crea un `.env` local
# (ignorado por git) a partir de `.env.example`. Ver docs/arquitectura.md.
# Para recuperar una funcionalidad en la web publicada, ponla a true.

VITE_FEATURE_HINTS=true
VITE_FEATURE_CHALLENGE_MODE=false
VITE_FEATURE_SYMBOL_ROUNDS=false

# URL pública de la web (sin barra final). Se usa en las previsualizaciones al compartir el enlace.
VITE_SITE_URL=https://veritytrainer.vercel.app

# Repositorio público, enlazado en el pie de página. Vacío = sin enlace (solo el crédito).
VITE_REPO_URL=https://github.com/unvoid/verity-trainer
